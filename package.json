{
  "name": "@qjcnb/dsh-mcp",
  "version": "0.2.0",
  "description": "Use DSH minimal, full-access sessions from any MCP client in the same project",
  "license": "MIT",
  "bin": {
    "dsh-mcp": "dist/server.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/qjcnmd/dsh-mcp.git"
  },
  "homepage": "https://github.com/qjcnmd/dsh-mcp#readme",
  "bugs": "https://github.com/qjcnmd/dsh-mcp/issues",
  "files": [
    "dist",
    "plugins/dsh-mcp",
    "README.md"
  ],
  "keywords": [
    "dsh",
    "mcp",
    "model-context-protocol"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare": "npm run build",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "prepack": "npm run build",
    "typecheck": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:live": "npm run build && node tests/integration/live-smoke.mjs",
    "test:package": "npm run build && node tests/integration/package-smoke.mjs",
    "test:watch": "vitest --config vitest.config.ts",
    "dev": "tsx src/server.ts",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.0.0",
    "ws": "8.21.3",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
